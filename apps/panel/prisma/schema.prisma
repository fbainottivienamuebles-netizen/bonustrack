// Modelo de datos del panel (spec, sección 6).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SectionType {
  intro
  verso
  preestribillo
  estribillo
  puente
  solo
  outro
}

enum ClickSound {
  madera
  cencerro
  beep
}

enum TempoSource {
  manual
  detectadoEnVivo
}

model Song {
  id                 String      @id @default(uuid())
  titulo             String
  artistaOriginal    String
  duracionSegundos   Int
  bpmManual          Int?
  fuenteTempo        TempoSource @default(manual)
  /// Compás, ej. 4/4, 3/4, 6/8 (clics por compás y acento del primer tiempo)
  compas             String      @default("4/4")
  /// Compases de cuenta previa (1 a 4)
  compasesCuenta     Int         @default(2)
  sonidoClic         ClickSound  @default(madera)
  /// Video de fondo en loop para la Pantalla (público)
  videoUrl           String?
  /// Tempo al que va el video, para ajustar su velocidad
  videoBpmReferencia Int?
  /// Link de referencia (YouTube, Spotify…), solo para el panel
  referenciaUrl      String?
  secciones          Section[]
  tandaSongs         TandaSong[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model Section {
  id     String      @id @default(uuid())
  songId String
  song   Song        @relation(fields: [songId], references: [id], onDelete: Cascade)
  orden  Int
  tipo   SectionType
  lineas Line[]

  @@index([songId, orden])
}

model Line {
  id             String  @id @default(uuid())
  sectionId      String
  section        Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  orden          Int
  texto          String
  tiempoInicioMs Int

  @@index([sectionId, orden])
}

model Setlist {
  id        String   @id @default(uuid())
  nombre    String
  tandas    Tanda[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tanda {
  id        String      @id @default(uuid())
  setlistId String
  setlist   Setlist     @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  orden     Int
  nombre    String
  temas     TandaSong[]

  @@index([setlistId, orden])
}

// Un tema puede borrarse sólo si no está en ningún setlist (Restrict).
model TandaSong {
  id      String @id @default(uuid())
  tandaId String
  tanda   Tanda  @relation(fields: [tandaId], references: [id], onDelete: Cascade)
  songId  String
  song    Song   @relation(fields: [songId], references: [id], onDelete: Restrict)
  orden   Int

  @@index([tandaId, orden])
}
